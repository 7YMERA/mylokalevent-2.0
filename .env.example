# Copy this file to .env.local and fill in real values. Never commit .env files.
# The server refuses to start while any value below is missing or a placeholder.

# Public URL of the site, used for links and share previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "on" once the Google provider is configured in Supabase (see README).
# Off by default, which hides the "Continue with Google" button.
# GOOGLE_SIGN_IN=on

# Supabase project (Project Settings > API). The publishable key is safe in the
# browser; never put the secret / service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional, server-only: used by `npm run demo:users` on your machine to create
# demo accounts. It bypasses all access rules, so keep it out of the repo and
# never give it a NEXT_PUBLIC_ prefix. Also used by the Stripe webhook and cron.
# SUPABASE_SECRET_KEY=

# Payments (Stripe). The payment flow (task 4) refuses to run until all three
# are set; the rest of the app works without them. Get these from the Stripe
# dashboard. STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you create
# (or `stripe listen` locally). Only the publishable key may be NEXT_PUBLIC_.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
